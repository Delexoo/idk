<Window x:Class="Idk.Views.OverlayWindow"
        x:Name="RootWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Icon="pack://application:,,,/Assets/idk.ico"
        Width="128"
        Height="32"
        MinWidth="128"
        MinHeight="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.EdgeMode="Unspecified"
        FontFamily="{StaticResource IdkFontBody}">
    <Window.Resources>
        <Style x:Key="OverlayToolbarBtnBase" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OverlayBtnHoverBg}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OverlayBtnHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OverlayBtnPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayCardGhost" TargetType="Button" BasedOn="{StaticResource OverlayToolbarBtnBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OverlayQueryPlaceholder}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="OverlayQueryFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default / theme TextBox chrome draws a rectangular focus box on the ask field; strip it. -->
        <Style x:Key="OverlayQueryTextBox" TargetType="TextBox" BasedOn="{x:Null}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="#C8C8C8" />
            <Setter Property="SelectionBrush" Value="#404040" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OverlayQueryFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayExitIcon" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource OverlayExitHoverBg}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource OverlayExitHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource OverlayExitPressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Transparent outside the capsule so WPF can antialias the curve. A hard window region stair-steps the ends. -->
    <Grid x:Name="RootContentGrid"
          Background="Transparent"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid x:Name="ShellVisualRoot"
              Opacity="1"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
        <Border x:Name="ShellCornerFill"
                Visibility="Collapsed"
                Background="#181818"
                CornerRadius="16"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True" />
        <Border x:Name="ShellOuter"
            ClipToBounds="False"
            CornerRadius="16"
            Background="#181818"
            BorderBrush="Transparent"
            BorderThickness="0"
            SnapsToDevicePixels="True"
            IsHitTestVisible="True"
            UseLayoutRounding="True">
        <Grid x:Name="ShellContent">
            <Grid x:Name="PillPanel"
                  Margin="10,0,4,0"
                  Background="Transparent"
                  MouseDown="PillPanel_OnMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="{StaticResource IdkFontSymbol}"
                           FontSize="12"
                           Margin="2,0,8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="Grayscale">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8A8A8A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ShellOuter}" Value="True">
                                    <Setter Property="Foreground" Value="#B0B0B0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootWin}" Value="True">
                                    <Setter Property="Foreground" Value="#B0B0B0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid x:Name="PillTextChrome" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Stretch" Opacity="1">
                    <TextBlock x:Name="QueryPlaceholder"
                               Text="Ask Anything!"
                               Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#8E8E8E"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="QueryBox"
                             Style="{StaticResource OverlayQueryTextBox}"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Foreground="#ECECEC"
                             Focusable="True"
                             TextChanged="QueryBox_TextChanged"
                             GotFocus="QueryBox_GotFocus"
                             LostFocus="QueryBox_LostFocus"
                             KeyDown="QueryBox_OnKeyDown" />
                </Grid>
            </Grid>

            <Grid x:Name="CardPanel" Visibility="Collapsed" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="CardHeaderBar"
                        Grid.Row="0"
                        Padding="14,10,6,8"
                        BorderBrush="{DynamicResource OverlayCardDivider}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        PreviewMouseLeftButtonDown="CardHeader_PreviewMouseLeftButtonDown">
                    <Grid MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectionPreview"
                                   Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IdkFontBody}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OverlaySelectionPreview}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="BtnSimpler"
                                    Content="Simpler"
                                    Style="{StaticResource OverlayCardGhost}"
                                    Click="OnSimpler" />
                            <Button x:Name="BtnExit"
                                    Style="{StaticResource OverlayExitIcon}"
                                    Click="OnExitClick"
                                    ToolTip="Close"
                                    AutomationProperties.Name="Close">
                                <Path Data="M5,5 L11,11 M11,5 L5,11"
                                      Stroke="{DynamicResource OverlayExitStroke}"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="AnswerScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,8,10,8"
                              Background="Transparent"
                              PreviewMouseWheel="AnswerScroll_OnPreviewMouseWheel">
                    <StackPanel>
                        <StackPanel x:Name="CardMessagesPanel" />
                        <TextBlock x:Name="ErrorText"
                                   Visibility="Collapsed"
                                   Foreground="#C98A8A"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <Button x:Name="UpgradeButton"
                                Content="Upgrade"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Padding="14,7"
                                Cursor="Hand"
                                Foreground="White"
                                Background="#2563EB"
                                BorderBrush="#1D4ED8"
                                BorderThickness="1"
                                Click="Upgrade_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="CardFollowUpBar"
                        Grid.Row="2"
                        Margin="12,4,12,14"
                        Padding="12,0"
                        MinHeight="36"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource OverlayCardDivider}"
                        BorderThickness="1"
                        Background="{DynamicResource OverlayAssistantBg}">
                    <Grid>
                        <TextBlock x:Name="FollowUpPlaceholder"
                                   Text="Ask a follow-up…"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource OverlayFollowUpPlaceholder}"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="FollowUpBox"
                                 Style="{StaticResource OverlayQueryTextBox}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource OverlayQueryText}"
                                 IsEnabled="False"
                                 TextChanged="FollowUpBox_TextChanged"
                                 GotFocus="FollowUpBox_GotFocus"
                                 LostFocus="FollowUpBox_LostFocus"
                                 KeyDown="FollowUpBox_OnKeyDown" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
        </Grid>
    </Grid>
</Window>
