<Window x:Class="Idk.Views.OverlayWindow"
        x:Name="RootWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Icon="pack://application:,,,/Assets/idk.ico"
        Width="128"
        Height="31"
        MinWidth="118"
        MinHeight="29"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#181818"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        ResizeMode="NoResize"
        SnapsToDevicePixels="False"
        UseLayoutRounding="False"
        FontFamily="{StaticResource IdkFontBody}">
    <Window.Resources>
        <Style x:Key="OverlayToolbarBtnBase" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2E2E2E" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#242424" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayCardGhost" TargetType="Button" BasedOn="{StaticResource OverlayToolbarBtnBase}">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
        </Style>

        <Style x:Key="OverlayQueryFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default / theme TextBox chrome draws a rectangular focus box on the ask field; strip it. -->
        <Style x:Key="OverlayQueryTextBox" TargetType="TextBox" BasedOn="{x:Null}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="#C8C8C8" />
            <Setter Property="SelectionBrush" Value="#404040" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OverlayQueryFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayExitIcon" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2A2A" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#222222" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Opaque #181818 under rounded clip so HWND corners are not transparent (no white wedges / gray frame). -->
    <Grid x:Name="RootContentGrid"
          Background="#181818"
          SnapsToDevicePixels="False"
          UseLayoutRounding="False">
        <Grid x:Name="ShellVisualRoot"
              RenderTransformOrigin="0.5,0.5"
              Opacity="1"
              SnapsToDevicePixels="False"
              UseLayoutRounding="False">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ShellEnterScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
        <Border x:Name="ShellCornerFill"
                Background="#181818"
                CornerRadius="15.5"
                SnapsToDevicePixels="False"
                UseLayoutRounding="False" />
        <Border x:Name="ShellOuter"
            ClipToBounds="True"
            CornerRadius="15.5"
            Background="#181818"
            BorderBrush="Transparent"
            BorderThickness="0"
            SnapsToDevicePixels="False"
            IsHitTestVisible="True"
            UseLayoutRounding="False">
        <Grid>
            <Grid x:Name="PillPanel"
                  Margin="6,0,6,0"
                  Background="Transparent"
                  MouseDown="PillPanel_OnMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0"
                         Width="12"
                         Height="12"
                         Margin="0,0,5,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         IsHitTestVisible="False">
                    <Canvas Width="20" Height="20" SnapsToDevicePixels="True">
                        <Ellipse Canvas.Left="1"
                                 Canvas.Top="2"
                                 Width="9.5"
                                 Height="9.5"
                                 Stroke="#8A8A8A"
                                 StrokeThickness="1.35"
                                 Fill="Transparent">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ShellOuter}" Value="True">
                                            <Setter Property="Stroke" Value="#A8A8A8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootWin}" Value="True">
                                            <Setter Property="Stroke" Value="#A8A8A8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Line X1="10.5"
                              Y1="10.5"
                              X2="16.5"
                              Y2="16.5"
                              Stroke="#8A8A8A"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Line.Style>
                                <Style TargetType="Line">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ShellOuter}" Value="True">
                                            <Setter Property="Stroke" Value="#A8A8A8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootWin}" Value="True">
                                            <Setter Property="Stroke" Value="#A8A8A8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Line.Style>
                        </Line>
                    </Canvas>
                </Viewbox>

                <Grid x:Name="PillTextChrome" Grid.Column="1" VerticalAlignment="Stretch" Opacity="1">
                    <TextBlock x:Name="QueryPlaceholder"
                               Text="Ask Anything!"
                               Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#8E8E8E"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="QueryBox"
                             Style="{StaticResource OverlayQueryTextBox}"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Foreground="#ECECEC"
                             Focusable="True"
                             TextChanged="QueryBox_TextChanged"
                             GotFocus="QueryBox_GotFocus"
                             LostFocus="QueryBox_LostFocus"
                             KeyDown="QueryBox_OnKeyDown" />
                </Grid>
            </Grid>

            <Grid x:Name="CardPanel" Visibility="Collapsed" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="CardHeaderBar"
                        Grid.Row="0"
                        Padding="10,8,10,8"
                        BorderBrush="#333333"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        PreviewMouseLeftButtonDown="CardHeader_PreviewMouseLeftButtonDown">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="BtnSimpler"
                                    Content="Simpler"
                                    Style="{StaticResource OverlayCardGhost}"
                                    Click="OnSimpler" />
                            <Button x:Name="BtnExit"
                                    Style="{StaticResource OverlayExitIcon}"
                                    Click="OnExitClick"
                                    ToolTip="Close"
                                    AutomationProperties.Name="Close">
                                <Path Data="M5,5 L11,11 M11,5 L5,11"
                                      Stroke="#B0B0B0"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="11"
                                      Height="11"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="AnswerScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12,10,12,12"
                              Background="Transparent"
                              PreviewMouseWheel="AnswerScroll_OnPreviewMouseWheel">
                    <StackPanel>
                        <StackPanel x:Name="CardMessagesPanel" />
                        <TextBlock x:Name="ErrorText"
                                   Visibility="Collapsed"
                                   Foreground="#C98A8A"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="CardFollowUpBar"
                        Grid.Row="2"
                        Padding="10,7,10,9"
                        BorderBrush="#333333"
                        BorderThickness="0,1,0,0"
                        Background="#1A1A1A">
                    <Grid MinHeight="28">
                        <TextBlock x:Name="FollowUpPlaceholder"
                                   Text="Ask a follow-up…"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#6E6E6E"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="FollowUpBox"
                                 Style="{StaticResource OverlayQueryTextBox}"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Foreground="#ECECEC"
                                 IsEnabled="False"
                                 TextChanged="FollowUpBox_TextChanged"
                                 GotFocus="FollowUpBox_GotFocus"
                                 LostFocus="FollowUpBox_LostFocus"
                                 KeyDown="FollowUpBox_OnKeyDown" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
        </Grid>
    </Grid>
</Window>
