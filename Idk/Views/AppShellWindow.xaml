<Window x:Class="Idk.Views.AppShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="idk"
        Icon="pack://application:,,,/Assets/idk.ico"
        MinWidth="640"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg}"
        FontFamily="{StaticResource IdkFontBody}"
        FontSize="14"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ContentControl x:Name="Host" Focusable="False" />
</Window>
