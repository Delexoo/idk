<UserControl x:Class="Idk.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Idk.Services"
        MinWidth="820"
        MinHeight="600"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource IdkFontBody}"
        FontSize="14">
    <UserControl.Resources>
        <Style x:Key="DashPageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
        </Style>
        <Style x:Key="DashPageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="DashRowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashRowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="DashNavGeneral" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DashStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="140" />
        </Style>

        <Style x:Key="DashStatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
        </Style>

        <Style x:Key="DashStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DashHeroCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="DashInsightPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashInsightPillBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashInsightPillBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="DashDetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashSubtle}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DashDetailBlock" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="DashDetailBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="DashPanelCard" TargetType="Border" BasedOn="{StaticResource DashDetailBlock}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <DataTemplate DataType="{x:Type services:DashboardDayBar}">
            <StackPanel HorizontalAlignment="Stretch">
                <Grid Height="84" Margin="0,0,0,8">
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Height="{Binding BarHeightPx}"
                            CornerRadius="5,5,2,2"
                            Margin="4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource DashBarDefault}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource DashBarEmpty}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DashAccentBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Count}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DashInk}" />
                <TextBlock Text="{Binding DayLabel}"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource DashMuted}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="DashNavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontSymbol}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashSidebarSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashSubtle}" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="DashSettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="DashIconHost" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource DashIconHostBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashIconHostBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DashIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontSymbol}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashModeSegment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Btn"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="{DynamicResource DashAccentBlue}" />
                                <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="{DynamicResource DashModeSegmentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Btn" Property="Background" Value="{DynamicResource DashAccentBlueDark}" />
                                <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashSwitch" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Content" Value="" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="48"
                                Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource DashSwitchTrackOff}"
                                SnapsToDevicePixels="True">
                            <Border x:Name="Knob"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource DashSwitchKnob}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobT" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource DashAccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource DashSwitchTrackOff}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashReplayBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="{DynamicResource DashBtnBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashBtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashLicenseBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource DashAccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashAccentBlueDark}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,14,8,0" />
        </Style>

        <Style x:Key="DashInfoFab" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Keyboard shortcuts" />
            <Setter Property="AutomationProperties.Name" Value="Keyboard shortcuts" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource DashFabBg}"
                                BorderBrush="{DynamicResource DashFabBorder}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="{StaticResource IdkFontSymbol}"
                                       FontSize="14"
                                       Foreground="{DynamicResource DashMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BannerErr" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BannerErrBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BannerErrBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="DashHistoryMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Padding" Value="14,9,16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource DashMenuHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DashSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashHistoryMenuItemDelete" TargetType="MenuItem" BasedOn="{StaticResource DashHistoryMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource DashMenuDelete}" />
        </Style>

        <Style x:Key="DashHistoryMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="12,5,12,5"
                                Background="{DynamicResource DashMenuSeparator}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashHistoryContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DashHistoryMenuItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource DashFabBg}"
                                BorderBrush="{DynamicResource DashFabBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                MinWidth="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource DashMenuAccent}"
                                        CornerRadius="8,0,0,8" />
                                <StackPanel Grid.Column="1" Margin="0,6,0,6">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashHistoryMoreBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ToolTip" Value="More options" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MoreBd"
                                Background="Transparent"
                                CornerRadius="6">
                            <TextBlock Text="&#xE712;"
                                       FontFamily="{StaticResource IdkFontSymbol}"
                                       FontSize="14"
                                       Foreground="{DynamicResource DashMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MoreBd" Property="Background" Value="{DynamicResource DashMenuHover}" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashChatQuickBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="{DynamicResource DashMenuBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashMenuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashChatQuickBtnDanger" TargetType="Button" BasedOn="{StaticResource DashChatQuickBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DashMenuDelete}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashChatDangerBorder}" />
            <Setter Property="Background" Value="{DynamicResource DashChatDangerBg}" />
        </Style>

        <DataTemplate DataType="{x:Type services:DashboardChatRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="{Binding TitleDisplay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource DashInk}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WhenLabel}"
                               Foreground="{DynamicResource DashSubtle}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource DashHistoryMoreBtn}"
                        PreviewMouseLeftButtonDown="HistoryMoreButton_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonDown="HistoryMoreButton_PreviewMouseRightButtonDown" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type services:ChatHistorySectionDivider}">
            <Border Height="1"
                    Background="{DynamicResource DashChatDivider}"
                    Margin="6,10,6,10"
                    IsHitTestVisible="False" />
        </DataTemplate>

        <Style x:Key="DashHistoryList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="10,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DashNavSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Converter={x:Static services:ChatHistoryDividerConverter.Instance}}"
                                         Value="True">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashActivityList" TargetType="ListBox" BasedOn="{StaticResource DashHistoryList}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DashShortcutRow" TargetType="Border">
            <Setter Property="Padding" Value="0,0,0,14" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="DashApiKeyHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashApiKeyHostBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashApiKeyHostBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <Style x:Key="DashFeedbackBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="140" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CaretBrush" Value="{DynamicResource DashInk}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="DashApiKeyBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource DashInk}" />
        </Style>

        <Style x:Key="DashChatAskBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0,8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CaretBrush" Value="{DynamicResource DashInk}" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent"
                                BorderThickness="0"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashChatSearchBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashApiKeyHostBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashApiKeyHostBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="480" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,0,8,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="DashChatAskBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource DashAccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashAccentBlueDark}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <TextBlock Text="&#xE724;"
                                       FontFamily="{StaticResource IdkFontSymbol}"
                                       FontSize="13"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashApiResetBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,7" />
        </Style>

        <Style x:Key="DashSettingsDangerBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DashMenuDelete}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashChatDangerBorder}" />
            <Setter Property="Background" Value="{DynamicResource DashChatDangerBg}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: General + chats -->
        <Border Grid.Column="0"
                Background="{DynamicResource DashSidebarBg}"
                BorderBrush="{DynamicResource DashSidebarBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Width="80"
                        Height="80"
                        Margin="20,28,20,12"
                        CornerRadius="18"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource DashLogoBorder}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/idk.png"
                                    Stretch="UniformToFill"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Selection assistant"
                           Foreground="{DynamicResource DashSubtle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           LineHeight="16"
                           Margin="18,0,18,24" />

                <Grid Margin="14,24,14,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DashboardNav"
                            Grid.Row="0"
                            Style="{StaticResource DashNavGeneral}"
                            MouseLeftButtonUp="DashboardNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE9D2;" />
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsNav"
                            Grid.Row="1"
                            Style="{StaticResource DashNavGeneral}"
                            Margin="0,0,0,2"
                            MouseLeftButtonUp="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE713;" />
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="HowToUseNav"
                            Grid.Row="2"
                            Style="{StaticResource DashNavGeneral}"
                            Margin="0,0,0,2"
                            MouseLeftButtonUp="HowToUseNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE946;" />
                            <TextBlock Text="How to use"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="FeedbackNav"
                            Grid.Row="3"
                            Style="{StaticResource DashNavGeneral}"
                            Margin="0,0,0,2"
                            MouseLeftButtonUp="FeedbackNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xED15;" />
                            <TextBlock Text="Send feedback"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Text="Chats" Style="{StaticResource DashSidebarSection}" Margin="4,8,0,8" />

                    <ScrollViewer x:Name="ChatHistoryScroller"
                                  Grid.Row="5"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                        <StackPanel>
                            <ListBox x:Name="HistoryList"
                                     Style="{StaticResource DashHistoryList}"
                                     SelectionChanged="HistoryList_SelectionChanged"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="HistoryEmpty"
                                       Text="No chats yet."
                                       Foreground="{DynamicResource DashSubtle}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="10,2,0,0" />
                </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Background="{DynamicResource AppBg}">
            <ScrollViewer x:Name="ScrollDashboard"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="Overview of your idk usage and recent activity."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,20" />

                    <Border x:Name="DashboardLicenseCard" Style="{StaticResource DashSettingCard}">
                        <StackPanel>
                            <TextBlock Text="This computer" Style="{StaticResource DashRowLabel}" />
                            <TextBlock x:Name="DashboardLicenseStatusText"
                                       Text="idk is $5.99 once for this computer."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="One purchase covers this computer. Copying the app or the license file does not license another computer."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="Promotional code" Style="{StaticResource DashRowDesc}" Margin="0,14,0,0" />
                            <Border x:Name="DashboardLicensePromoPanel" Style="{StaticResource DashApiKeyHost}" Margin="0,8,0,0">
                                <TextBox x:Name="DashboardLicensePromoInput"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="12,8"
                                         FontSize="13"
                                         Foreground="{DynamicResource DashInk}"
                                         CaretBrush="{DynamicResource DashInk}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DashboardLicenseBuyButton"
                                        Content="Buy for this computer"
                                        Style="{StaticResource DashLicenseBtn}"
                                        Click="LicenseBuy_Click" />
                                <Button x:Name="DashboardLicenseCheckButton"
                                        Content="Check this computer"
                                        Style="{StaticResource DashReplayBtn}"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Click="LicenseCheck_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashHeroCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource DashAccentBlue}"
                                    CornerRadius="2"
                                    Margin="0,2,14,2" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DashboardGreeting"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DashInk}"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="DashboardHeroSubtitle"
                                           Style="{StaticResource DashPageSub}"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                                <Border x:Name="DashboardStreakBadge"
                                        Background="{DynamicResource DashStreakBadgeBg}"
                                        BorderBrush="{DynamicResource DashStreakBadgeBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="DashboardStreakText"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DashStreakBadgeFg}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <WrapPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                        <Border Style="{StaticResource DashStatCard}">
                            <StackPanel>
                                <TextBlock x:Name="StatTotalAsks" Text="0" Style="{StaticResource DashStatValue}" />
                                <TextBlock Text="Total asks" Style="{StaticResource DashStatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashStatCard}">
                            <StackPanel>
                                <TextBlock x:Name="StatPinned" Text="0" Style="{StaticResource DashStatValue}" />
                                <TextBlock Text="Pinned chats" Style="{StaticResource DashStatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashStatCard}">
                            <StackPanel>
                                <TextBlock x:Name="StatStreak" Text="0" Style="{StaticResource DashStatValue}" />
                                <TextBlock Text="Day streak" Style="{StaticResource DashStatLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashStatCard}">
                            <StackPanel>
                                <TextBlock x:Name="StatApiKey" Text="—" Style="{StaticResource DashStatValue}" FontSize="22" />
                                <TextBlock Text="API key" Style="{StaticResource DashStatLabel}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashPanelCard}">
                            <StackPanel>
                                <TextBlock Text="LAST 7 DAYS" Style="{StaticResource DashDetailLabel}" Margin="0,0,0,12" />
                                <ItemsControl x:Name="DashboardWeekChart">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="DashboardWeekSummary"
                                           Foreground="{DynamicResource DashMuted}"
                                           FontSize="12"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource DashPanelCard}">
                            <StackPanel>
                                <TextBlock Text="CURRENT SETTINGS" Style="{StaticResource DashDetailLabel}" Margin="0,0,0,12" />
                                <WrapPanel x:Name="DashboardGlancePills" />
                                <TextBlock x:Name="DashboardCurrentSettingsEmpty"
                                           Foreground="{DynamicResource DashMuted}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Text="No optional settings are on yet." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="DashboardPinnedHeader"
                               Text="PINNED"
                               Style="{StaticResource DashDetailLabel}"
                               Margin="0,4,0,8"
                               Visibility="Collapsed" />
                    <Border x:Name="DashboardPinnedPanel"
                            Style="{StaticResource DashDetailBlock}"
                            Padding="8,6,8,8"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <ListBox x:Name="DashboardPinnedList"
                                 Style="{StaticResource DashActivityList}"
                                 SelectionChanged="DashboardPinnedList_SelectionChanged" />
                    </Border>

                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource DashDetailLabel}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource DashDetailBlock}" Padding="8,6,8,8" Margin="0,0,0,0">
                        <StackPanel>
                            <ListBox x:Name="DashboardActivityList"
                                     Style="{StaticResource DashActivityList}"
                                     SelectionChanged="DashboardActivityList_SelectionChanged"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="DashboardActivityEmpty"
                                       Text="No asks yet."
                                       Foreground="{DynamicResource DashSubtle}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="8,6" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ScrollChatDetail" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatThreadScroller"
                              Grid.Row="0"
                              Padding="32,36,32,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                        <StackPanel Margin="0,0,0,20" HorizontalAlignment="Center">
                            <TextBlock x:Name="ChatDetailTitle"
                                       Style="{StaticResource DashPageTitle}"
                                       Text="Chat"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="ChatDetailWhen"
                                       Style="{StaticResource DashPageSub}"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                            <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Content="Copy"
                                        Style="{StaticResource DashChatQuickBtn}"
                                        Click="ChatQuickCopy_Click" />
                                <Button x:Name="ChatQuickPinBtn"
                                        Style="{StaticResource DashChatQuickBtn}"
                                        Click="ChatQuickPin_Click" />
                                <Button Content="Export"
                                        Style="{StaticResource DashChatQuickBtn}"
                                        Click="ChatQuickExport_Click" />
                                <Button Content="Delete"
                                        Style="{StaticResource DashChatQuickBtnDanger}"
                                        Click="ChatQuickDelete_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel x:Name="ChatMessagesPanel" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="{DynamicResource DashChatDetailBg}"
                        BorderBrush="{DynamicResource DashSidebarBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="40,16,100,24"
                        MinHeight="88"
                        VerticalAlignment="Bottom">
                    <Grid HorizontalAlignment="Stretch"
                          MaxWidth="920"
                          Margin="0,0,0,0"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource DashChatSearchBar}">
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0"
                                      MinHeight="48"
                                      VerticalAlignment="Stretch">
                                    <TextBlock x:Name="ChatFollowUpPlaceholder"
                                               Text="Ask anything…"
                                               Foreground="{DynamicResource DashSubtle}"
                                               FontSize="14"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBox x:Name="ChatFollowUpInput"
                                             Style="{StaticResource DashChatAskBox}"
                                             KeyDown="ChatFollowUpInput_KeyDown"
                                             TextChanged="ChatFollowUpInput_TextChanged"
                                             GotFocus="ChatFollowUpInput_GotFocus"
                                             LostFocus="ChatFollowUpInput_LostFocus" />
                                </Grid>
                                <Button Grid.Column="1"
                                        Style="{StaticResource DashChatAskBtn}"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0"
                                        ToolTip="Ask"
                                        Click="ChatFollowUpAsk_Click" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="4,8,0,0">
                            <TextBlock x:Name="ChatFollowUpHint"
                                       Text="Add your OpenRouter API key in Settings to ask follow-up questions."
                                       Foreground="{DynamicResource DashSubtle}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="ChatFollowUpLoading"
                                       Text="Thinking…"
                                       Foreground="{DynamicResource DashMuted}"
                                       FontSize="12"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="ChatFollowUpError"
                                       Foreground="{DynamicResource DashErrorFg}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="ScrollSettings"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                    <TextBlock Text="Settings"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="A license is $5.99 once for this computer. idk starts after this computer is licensed and an API key is saved."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,36" />

                    <Border Style="{StaticResource DashSettingCard}">
                        <StackPanel>
                            <TextBlock Text="This computer" Style="{StaticResource DashRowLabel}" />
                            <TextBlock x:Name="LicenseStatusText"
                                       Text="idk is $5.99 once for this computer."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="One purchase covers this computer. Copying the app or the license file does not license another computer."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <StackPanel x:Name="LicensePromoPanel">
                                <TextBlock Text="Promotional code" Style="{StaticResource DashRowDesc}" Margin="0,14,0,0" />
                                <Border Style="{StaticResource DashApiKeyHost}" Margin="0,8,0,0">
                                    <TextBox x:Name="LicensePromoInput"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="12,8"
                                             FontSize="13"
                                             Foreground="{DynamicResource DashInk}"
                                             CaretBrush="{DynamicResource DashInk}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LicenseBuyButton"
                                        Content="Buy for this computer"
                                        Style="{StaticResource DashLicenseBtn}"
                                        Click="LicenseBuy_Click" />
                                <Button x:Name="LicenseCheckButton"
                                        Content="Check this computer"
                                        Style="{StaticResource DashReplayBtn}"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Click="LicenseCheck_Click" />
                            </StackPanel>
                            <TextBlock x:Name="LicenseVersionText"
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE70F;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Selection mode"
                                           Style="{StaticResource DashRowLabel}" />
                                <TextBlock x:Name="SelectWithoutShiftDesc"
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DashSegmentTrackBg}"
                                    BorderBrush="{DynamicResource DashSegmentTrackBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SelectionModeShift"
                                                 GroupName="IdkSelectionMode"
                                                 Content="Shift + select"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="SelectionModeChoice_Changed" />
                                    <RadioButton x:Name="SelectionModeInstant"
                                                 GroupName="IdkSelectionMode"
                                                 Content="Instant"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="SelectionModeChoice_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE790;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Appearance"
                                           Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Switch between dark and light for the dashboard and overlay."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DashSegmentTrackBg}"
                                    BorderBrush="{DynamicResource DashSegmentTrackBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeModeDark"
                                                 GroupName="IdkThemeMode"
                                                 Content="Dark"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="ThemeModeChoice_Changed" />
                                    <RadioButton x:Name="ThemeModeLight"
                                                 GroupName="IdkThemeMode"
                                                 Content="Light"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="ThemeModeChoice_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE785;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OpenRouter API key" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Paste your key from openrouter.ai. idk saves it locally and picks models for you."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashApiKeyHost}">
                                        <PasswordBox x:Name="ApiKeyInput"
                                                     Style="{StaticResource DashApiKeyBox}"
                                                     PasswordChanged="ApiKeyInput_PasswordChanged"
                                                     LostFocus="ApiKeyInput_LostFocus"
                                                     KeyDown="ApiKeyInput_KeyDown" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            x:Name="ApiKeyResetButton"
                                            Style="{StaticResource DashApiResetBtn}"
                                            Content="Reset"
                                            Margin="10,0,0,0"
                                            Click="ApiKeyReset_Click" />
                                </Grid>
                                <TextBlock x:Name="ApiKeyStatus"
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE7B3;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Screen capture" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="When you ask a question, idk captures your screen for extra context and more accurate answers."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ScreenCaptureToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="ScreenCaptureToggle_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE121;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Open at startup" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Launch idk when you sign in to Windows."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="LaunchLogin"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="LaunchLogin_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE7E8;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Hide from taskbar" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Keep this window off the taskbar while idk is on."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="HideFromTaskbarToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="HideFromTaskbarToggle_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE8F2;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Chat history" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Permanently remove all saved chats from this PC."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                                <Button x:Name="DeleteAllChatsButton"
                                        Content="Delete all chats"
                                        Style="{StaticResource DashSettingsDangerBtn}"
                                        Margin="0,14,0,0"
                                        Click="DeleteAllChats_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ErrorBanner"
                            Style="{StaticResource BannerErr}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="Error"
                                   FontSize="13"
                                   Foreground="{DynamicResource DashErrorFg}"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ScrollHowToUse"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                    <TextBlock Text="How to use idk"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="A quick walkthrough from API key to your first answer."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,28" />
                    <Border Style="{StaticResource DashDetailBlock}">
                        <TextBlock x:Name="HowToUseBody"
                                   Style="{StaticResource DashDetailBody}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ScrollFeedback"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                    <TextBlock Text="Feature feedback"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="Tell us what you'd like idk to do next — new features, improvements, or fixes."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,28" />
                    <Border Style="{StaticResource DashDetailBlock}">
                        <StackPanel>
                            <TextBlock Text="Your message"
                                       Style="{StaticResource DashRowLabel}" />
                            <TextBlock Text="We read every suggestion. Saved locally on this PC."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,12" />
                            <Border Style="{StaticResource DashApiKeyHost}"
                                    MinHeight="140"
                                    Height="Auto"
                                    Padding="0">
                                <TextBox x:Name="FeedbackInput"
                                         Style="{StaticResource DashFeedbackBox}" />
                            </Border>
                            <Button x:Name="FeedbackSendBtn"
                                    Content="Send feedback"
                                    Style="{StaticResource DashReplayBtn}"
                                    HorizontalAlignment="Left"
                                    Margin="0,16,0,0"
                                    Click="FeedbackSend_Click" />
                            <TextBlock x:Name="FeedbackStatus"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,12,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Shortcuts info (always visible, bottom-right) -->
        <Button x:Name="ShortcutsInfoBtn"
                Grid.ColumnSpan="2"
                Style="{StaticResource DashInfoFab}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                Panel.ZIndex="30"
                Click="ShortcutsInfo_Click" />

        <Grid x:Name="ShortcutsOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="20"
              Visibility="Collapsed">
            <Border Background="{DynamicResource DashShortcutsOverlay}"
                    MouseDown="ShortcutsOverlayBackdrop_MouseDown" />
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,28,78"
                    Background="{DynamicResource DashShortcutsPanelBg}"
                    BorderBrush="{DynamicResource DashShortcutsPanelBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,18"
                    MinWidth="300"
                    MaxWidth="360"
                    MouseDown="ShortcutsPanel_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.35"
                                      BlurRadius="16"
                                      ShadowDepth="4"
                                      Direction="270" />
                </Border.Effect>
                        <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Shortcuts"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashInk}"
                                   VerticalAlignment="Center" />
                        <Button Content="&#xE711;"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource DashMuted}"
                                FontFamily="{StaticResource IdkFontSymbol}"
                                FontSize="12"
                                Click="ShortcutsOverlayClose_Click" />
                    </Grid>
                    <Border Style="{StaticResource DashShortcutRow}">
                        <StackPanel>
                            <TextBlock Text="Shift + select" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DashInk}" />
                            <TextBlock Text="Default mode. Toggle Instant in Settings to skip holding Shift."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashShortcutRow}">
                        <StackPanel>
                            <TextBlock Text="Ctrl + Enter" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DashInk}" />
                            <TextBlock Text="Ask “What does this mean?” from the pill."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashShortcutRow}">
                        <StackPanel>
                            <TextBlock Text="Escape" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DashInk}" />
                            <TextBlock Text="Answer card → pill. Pill → hide overlay."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
