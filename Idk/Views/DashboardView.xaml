<UserControl x:Class="Idk.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Idk.Services"
        MinWidth="820"
        MinHeight="600"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource IdkFontBody}"
        FontSize="14">
    <UserControl.Resources>
        <Style x:Key="DashPageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
        </Style>
        <Style x:Key="DashPageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="DashRowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashRowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="DashNavItem" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashNavHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashNavPressed}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashNavSelected}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashNavHover}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashNavPressed}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="140" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashCardHoverBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashStatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
        </Style>

        <Style x:Key="DashStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DashHeroCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashCardHoverBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashInsightPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashInsightPillBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashInsightPillBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="DashDetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashSubtle}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DashDetailBlock" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,28" />
        </Style>

        <Style x:Key="DashDetailBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="DashPanelCard" TargetType="Border" BasedOn="{StaticResource DashDetailBlock}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <DataTemplate DataType="{x:Type services:DashboardDayBar}">
            <StackPanel HorizontalAlignment="Stretch">
                <Grid Height="84" Margin="0,0,0,8">
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Height="{Binding BarHeightPx}"
                            CornerRadius="5,5,2,2"
                            Margin="4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource DashBarDefault}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource DashBarEmpty}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DashAccentBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Count}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DashInk}" />
                <TextBlock Text="{Binding DayLabel}"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource DashMuted}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="DashNavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontSymbol}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashSidebarSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontDisplay}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DashSubtle}" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="DashSettingCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashCardBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,18" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DashIconHost" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DashIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IdkFontSymbol}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashModeSegment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Btn"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="{DynamicResource DashAccentBlue}" />
                                <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="{DynamicResource DashModeSegmentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Btn" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Btn" Property="Background" Value="{DynamicResource DashAccentBlueDark}" />
                                <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashSwitch" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Content" Value="" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="48"
                                Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource DashSwitchTrackOff}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border x:Name="Knob"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource DashSwitchKnob}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobT" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource DashAccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource DashSwitchTrackOffHover}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource DashAccentBlueDark}" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Track" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashReplayBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="{DynamicResource DashBtnBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashBtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Wash"
                                        Background="{DynamicResource DashHoverWash}"
                                        Opacity="0"
                                        CornerRadius="8"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource DashPressWash}" />
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashLicenseBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource DashAccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashAccentBlueDark}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,14,8,0" />
        </Style>

        <Style x:Key="DashInfoFab" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Keyboard shortcuts" />
            <Setter Property="AutomationProperties.Name" Value="Keyboard shortcuts" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{DynamicResource DashFabBg}"
                                BorderBrush="{DynamicResource DashFabBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Wash"
                                        Background="{DynamicResource DashHoverWash}"
                                        Opacity="0"
                                        CornerRadius="20"
                                        IsHitTestVisible="False" />
                                <TextBlock Text="&#xE946;"
                                           FontFamily="{StaticResource IdkFontSymbol}"
                                           FontSize="14"
                                           Foreground="{DynamicResource DashMuted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DashCardHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource DashPressWash}" />
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DashMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource IdkFontSymbol}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DashNavHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DashNavPressed}" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BannerErr" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BannerErrBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BannerErrBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="DashHistoryMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Padding" Value="14,9,16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource DashMenuHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DashSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashHistoryMenuItemDelete" TargetType="MenuItem" BasedOn="{StaticResource DashHistoryMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource DashMenuDelete}" />
        </Style>

        <Style x:Key="DashHistoryMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="12,5,12,5"
                                Background="{DynamicResource DashMenuSeparator}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashHistoryContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DashHistoryMenuItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource DashFabBg}"
                                BorderBrush="{DynamicResource DashFabBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                MinWidth="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource DashMenuAccent}"
                                        CornerRadius="8,0,0,8" />
                                <StackPanel Grid.Column="1" Margin="0,6,0,6">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashHistoryMoreBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ToolTip" Value="More options" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MoreBd"
                                Background="Transparent"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <TextBlock Text="&#xE712;"
                                       FontFamily="{StaticResource IdkFontSymbol}"
                                       FontSize="14"
                                       Foreground="{DynamicResource DashMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MoreBd" Property="Background" Value="{DynamicResource DashMenuHover}" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MoreBd" Property="Background" Value="{DynamicResource DashNavPressed}" />
                                <Setter TargetName="MoreBd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashChatQuickBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="{DynamicResource DashMenuBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashMenuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Wash"
                                        Background="{DynamicResource DashHoverWash}"
                                        Opacity="0"
                                        CornerRadius="7"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource DashPressWash}" />
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashChatQuickBtnDanger" TargetType="Button" BasedOn="{StaticResource DashChatQuickBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DashMenuDelete}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashChatDangerBorder}" />
            <Setter Property="Background" Value="{DynamicResource DashChatDangerBg}" />
        </Style>

        <DataTemplate DataType="{x:Type services:DashboardChatRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="{Binding TitleDisplay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource DashInk}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WhenLabel}"
                               Foreground="{DynamicResource DashSubtle}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource DashHistoryMoreBtn}"
                        PreviewMouseLeftButtonDown="HistoryMoreButton_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonDown="HistoryMoreButton_PreviewMouseRightButtonDown" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type services:ChatHistorySectionDivider}">
            <Border Height="1"
                    Background="{DynamicResource DashChatDivider}"
                    Margin="6,10,6,10"
                    IsHitTestVisible="False" />
        </DataTemplate>

        <Style x:Key="DashHistoryList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="10,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DashNavHover}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseCaptured" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DashNavPressed}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DashNavSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Converter={x:Static services:ChatHistoryDividerConverter.Instance}}"
                                         Value="True">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashActivityList" TargetType="ListBox" BasedOn="{StaticResource DashHistoryList}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DashShortcutRow" TargetType="Border">
            <Setter Property="Padding" Value="0,0,0,14" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="DashApiKeyHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashApiKeyHostBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashApiKeyHostBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="2,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashCardHoverBorder}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashAccentBlue}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashApiKeyBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource DashInk}" />
        </Style>

        <Style x:Key="DashChatAskBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DashInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0,8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CaretBrush" Value="{DynamicResource DashInk}" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent"
                                BorderThickness="0"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashChatSearchBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DashApiKeyHostBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashApiKeyHostBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="480" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,0,8,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashCardHoverBorder}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DashAccentBlue}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashChatAskBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DashOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource DashAccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashAccentBlueDark}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Wash"
                                        Background="{DynamicResource DashHoverWash}"
                                        Opacity="0"
                                        CornerRadius="17"
                                        IsHitTestVisible="False" />
                                <TextBlock Text="&#xE724;"
                                           FontFamily="{StaticResource IdkFontSymbol}"
                                           FontSize="13"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource DashPressWash}" />
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashApiResetBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,7" />
        </Style>

        <Style x:Key="DashSettingsDangerBtn" TargetType="Button" BasedOn="{StaticResource DashReplayBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DashMenuDelete}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DashChatDangerBorder}" />
            <Setter Property="Background" Value="{DynamicResource DashChatDangerBg}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: General + chats -->
        <Border Grid.Column="0"
                Background="{DynamicResource DashSidebarBg}"
                BorderBrush="{DynamicResource DashSidebarBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Width="80"
                        Height="80"
                        Margin="20,28,20,12"
                        CornerRadius="18"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource DashLogoBorder}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/idk.png"
                                    Stretch="UniformToFill"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>

                <TextBlock DockPanel.Dock="Bottom"
                           Text=""
                           Height="16"
                           Margin="0,0,0,12" />

                <Grid Margin="14,24,14,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <RadioButton x:Name="DashboardNav"
                                 Grid.Row="0"
                                 GroupName="DashNav"
                                 Style="{StaticResource DashNavItem}"
                                 Click="DashboardNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE9D2;" />
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BillingNav"
                                 Grid.Row="1"
                                 GroupName="DashNav"
                                 Style="{StaticResource DashNavItem}"
                                 Margin="0,0,0,2"
                                 Click="BillingNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE8C7;" />
                            <TextBlock Text="Billing"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SettingsNav"
                                 Grid.Row="2"
                                 GroupName="DashNav"
                                 Style="{StaticResource DashNavItem}"
                                 Margin="0,0,0,2"
                                 Click="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE713;" />
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="HowToUseNav"
                                 Grid.Row="3"
                                 GroupName="DashNav"
                                 Style="{StaticResource DashNavItem}"
                                 Margin="0,0,0,2"
                                 Click="HowToUseNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DashNavGlyph}" Text="&#xE946;" />
                            <TextBlock Text="How to use"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Grid.Row="4" Text="Chats" Style="{StaticResource DashSidebarSection}" Margin="4,8,0,8" />

                    <ScrollViewer x:Name="ChatHistoryScroller"
                                  Grid.Row="5"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                        <StackPanel>
                            <ListBox x:Name="HistoryList"
                                     Style="{StaticResource DashHistoryList}"
                                     SelectionChanged="HistoryList_SelectionChanged"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="HistoryEmpty"
                                       Text="No chats yet."
                                       Foreground="{DynamicResource DashSubtle}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="10,2,0,0" />
                </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Background="{DynamicResource AppBg}">
            <ScrollViewer x:Name="ScrollDashboard"
                          Padding="48,72,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="520" HorizontalAlignment="Center">
                    <TextBlock Text="idk"
                               Style="{StaticResource DashPageTitle}"
                               FontSize="40"
                               TextAlignment="Center" />
                    <TextBlock x:Name="DashboardFreeAsksText"
                               Text="5 free asks left. Then idk Pro is required."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,14,0,0" />
                    <TextBlock x:Name="DashboardLicenseStatusText"
                               Text="idk Pro is $3 a month for this computer."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"
                               Visibility="Collapsed" />
                    <Button x:Name="DashboardLicenseBuyButton"
                            Content="Upgrade"
                            Style="{StaticResource DashLicenseBtn}"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0"
                            Click="OpenBilling_Click" />

                    <TextBlock x:Name="DashboardPinnedHeader"
                               Text="Pinned"
                               Style="{StaticResource DashDetailLabel}"
                               Margin="0,56,0,8"
                               Visibility="Collapsed" />
                    <ListBox x:Name="DashboardPinnedList"
                             Style="{StaticResource DashActivityList}"
                             Margin="0,0,0,8"
                             Visibility="Collapsed"
                             SelectionChanged="DashboardPinnedList_SelectionChanged" />

                    <TextBlock Text="Recent"
                               Style="{StaticResource DashDetailLabel}"
                               Margin="0,48,0,8" />
                    <ListBox x:Name="DashboardActivityList"
                             Style="{StaticResource DashActivityList}"
                             SelectionChanged="DashboardActivityList_SelectionChanged"
                             Visibility="Collapsed" />
                    <TextBlock x:Name="DashboardActivityEmpty"
                               Text="No asks yet."
                               Foreground="{DynamicResource DashSubtle}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               TextAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ScrollChatDetail" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatThreadScroller"
                              Grid.Row="0"
                              Padding="32,36,32,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                        <StackPanel Margin="0,0,0,20" HorizontalAlignment="Center">
                            <TextBlock x:Name="ChatDetailTitle"
                                       Style="{StaticResource DashPageTitle}"
                                       Text="Chat"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="ChatDetailWhen"
                                       Style="{StaticResource DashPageSub}"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                            <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Content="Copy"
                                        Style="{StaticResource DashChatQuickBtn}"
                                        Click="ChatQuickCopy_Click" />
                                <Button x:Name="ChatQuickPinBtn"
                                        Style="{StaticResource DashChatQuickBtn}"
                                        Click="ChatQuickPin_Click" />
                                <Button Content="Export"
                                        Style="{StaticResource DashChatQuickBtn}"
                                        Click="ChatQuickExport_Click" />
                                <Button Content="Delete"
                                        Style="{StaticResource DashChatQuickBtnDanger}"
                                        Click="ChatQuickDelete_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel x:Name="ChatMessagesPanel" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="{DynamicResource DashChatDetailBg}"
                        BorderBrush="{DynamicResource DashSidebarBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="40,16,100,24"
                        MinHeight="88"
                        VerticalAlignment="Bottom">
                    <Grid HorizontalAlignment="Stretch"
                          MaxWidth="920"
                          Margin="0,0,0,0"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource DashChatSearchBar}">
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0"
                                      MinHeight="48"
                                      VerticalAlignment="Stretch">
                                    <TextBlock x:Name="ChatFollowUpPlaceholder"
                                               Text="Ask anything…"
                                               Foreground="{DynamicResource DashSubtle}"
                                               FontSize="14"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBox x:Name="ChatFollowUpInput"
                                             Style="{StaticResource DashChatAskBox}"
                                             KeyDown="ChatFollowUpInput_KeyDown"
                                             TextChanged="ChatFollowUpInput_TextChanged"
                                             GotFocus="ChatFollowUpInput_GotFocus"
                                             LostFocus="ChatFollowUpInput_LostFocus" />
                                </Grid>
                                <Button Grid.Column="1"
                                        Style="{StaticResource DashChatAskBtn}"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0"
                                        ToolTip="Ask"
                                        Click="ChatFollowUpAsk_Click" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="4,8,0,0">
                            <TextBlock x:Name="ChatFollowUpHint"
                                       Text="Subscribe to idk Pro in Settings before asking."
                                       Foreground="{DynamicResource DashSubtle}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="ChatFollowUpLoading"
                                       Text="Thinking…"
                                       Foreground="{DynamicResource DashMuted}"
                                       FontSize="12"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="ChatFollowUpError"
                                       Foreground="{DynamicResource DashErrorFg}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <Button x:Name="ChatFollowUpUpgrade"
                                    Content="Upgrade"
                                    Style="{StaticResource DashLicenseBtn}"
                                    Visibility="Collapsed"
                                    Click="OpenBilling_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="ScrollBilling"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                    <TextBlock Text="Billing"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="Five asks are free on this computer. idk Pro is $3 a month after that."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,36" />

                    <Border Style="{StaticResource DashSettingCard}">
                        <StackPanel>
                            <TextBlock Text="This computer" Style="{StaticResource DashRowLabel}" />
                            <TextBlock x:Name="LicenseStatusText"
                                       Text="idk Pro is $3 a month for this computer."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <TextBlock x:Name="BillingFreeAsksText"
                                       Text="5 free asks left. Then idk Pro is required."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="The subscription covers this computer while it is active. Copying the app or the license file does not unlock another computer."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LicenseBuyButton"
                                        Content="Upgrade"
                                        Style="{StaticResource DashLicenseBtn}"
                                        Click="LicenseBuy_Click" />
                                <Button x:Name="LicenseCheckButton"
                                        Content="Check this computer"
                                        Style="{StaticResource DashReplayBtn}"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Click="LicenseCheck_Click" />
                                <Button x:Name="LicenseManageButton"
                                        Content="Manage subscription"
                                        Style="{StaticResource DashReplayBtn}"
                                        HorizontalAlignment="Left"
                                        Margin="8,14,0,0"
                                        Visibility="Collapsed"
                                        Click="LicenseManage_Click" />
                            </StackPanel>
                            <TextBlock x:Name="LicenseVersionText"
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ScrollSettings"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                    <TextBlock Text="Settings"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="Selection, appearance, and startup."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,36" />

                    <Border Style="{StaticResource DashSettingCard}">
                        <StackPanel>
                            <TextBlock Text="Plan" Style="{StaticResource DashRowLabel}" />
                            <TextBlock x:Name="SettingsPlanSummary"
                                       Text="5 free asks left. Then idk Pro is required."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <Button Content="Open billing"
                                    Style="{StaticResource DashLicenseBtn}"
                                    Click="OpenBilling_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE70F;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Selection mode"
                                           Style="{StaticResource DashRowLabel}" />
                                <TextBlock x:Name="SelectWithoutShiftDesc"
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DashSegmentTrackBg}"
                                    BorderBrush="{DynamicResource DashSegmentTrackBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SelectionModeShift"
                                                 GroupName="IdkSelectionMode"
                                                 Content="Shift + select"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="SelectionModeChoice_Changed" />
                                    <RadioButton x:Name="SelectionModeInstant"
                                                 GroupName="IdkSelectionMode"
                                                 Content="Instant"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="SelectionModeChoice_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                    <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE721;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Search bar"
                                               Style="{StaticResource DashRowLabel}" />
                                    <TextBlock x:Name="AskBarPlacementDesc"
                                               Style="{StaticResource DashRowDesc}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border HorizontalAlignment="Left"
                                    Margin="0,14,0,0"
                                    Background="{DynamicResource DashSegmentTrackBg}"
                                    BorderBrush="{DynamicResource DashSegmentTrackBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AskBarFollowCursor"
                                                 GroupName="IdkAskBarPlacement"
                                                 Content="Follow cursor"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="AskBarPlacementChoice_Changed" />
                                    <RadioButton x:Name="AskBarBottomCenter"
                                                 GroupName="IdkAskBarPlacement"
                                                 Content="Bottom center"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="AskBarPlacementChoice_Changed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE790;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Appearance"
                                           Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Switch between dark and light for the dashboard and overlay."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DashSegmentTrackBg}"
                                    BorderBrush="{DynamicResource DashSegmentTrackBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeModeDark"
                                                 GroupName="IdkThemeMode"
                                                 Content="Dark"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="ThemeModeChoice_Changed" />
                                    <RadioButton x:Name="ThemeModeLight"
                                                 GroupName="IdkThemeMode"
                                                 Content="Light"
                                                 Style="{StaticResource DashModeSegment}"
                                                 Checked="ThemeModeChoice_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE785;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Model access" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Asking uses the model built into idk. The key stays sealed inside the app and is not saved in your settings."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE7B3;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Screen capture" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="When you ask a question, idk captures your screen for extra context and more accurate answers."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ScreenCaptureToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="ScreenCaptureToggle_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE121;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Open at startup" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Launch idk when you sign in to Windows."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="LaunchLogin"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="LaunchLogin_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE7E8;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Hide from taskbar" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Keep this window off the taskbar while idk is on."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="HideFromTaskbarToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="HideFromTaskbarToggle_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE890;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Hide from screen share" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Screenshots, screen shares, and streams skip idk windows, and this window leaves the taskbar and Alt+Tab. You still see idk. Task Manager still lists it."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="HideFromScreenShareToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource DashSwitch}"
                                          Click="HideFromScreenShareToggle_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashSettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DashIconHost}">
                                <TextBlock Style="{StaticResource DashIconGlyph}" Text="&#xE8F2;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Chat history" Style="{StaticResource DashRowLabel}" />
                                <TextBlock Text="Permanently remove all saved chats from this PC."
                                           Style="{StaticResource DashRowDesc}"
                                           Margin="0,4,0,0" />
                                <Button x:Name="DeleteAllChatsButton"
                                        Content="Delete all chats"
                                        Style="{StaticResource DashSettingsDangerBtn}"
                                        Margin="0,14,0,0"
                                        Click="DeleteAllChats_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ErrorBanner"
                            Style="{StaticResource BannerErr}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="Error"
                                   FontSize="13"
                                   Foreground="{DynamicResource DashErrorFg}"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ScrollHowToUse"
                          Padding="48,44,56,56"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                    <TextBlock Text="How to use idk"
                               Style="{StaticResource DashPageTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="A one-minute test with a few ridiculous words."
                               Style="{StaticResource DashPageSub}"
                               TextAlignment="Center"
                               Margin="0,10,0,28" />
                    <Border Style="{StaticResource DashDetailBlock}">
                        <StackPanel>
                            <TextBlock Text="Try it"
                                       Style="{StaticResource DashRowLabel}" />
                            <TextBlock x:Name="HowToUseTryPrompt"
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,6,0,0" />
                            <Border Background="{DynamicResource DashApiKeyHostBg}"
                                    BorderBrush="{DynamicResource DashApiKeyHostBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14"
                                    Margin="0,14,0,0">
                                <TextBox x:Name="HowToUsePracticeText"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False"
                                         IsUndoEnabled="False"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         FontSize="16"
                                         Foreground="{DynamicResource DashInk}"
                                         CaretBrush="Transparent"
                                         SelectionBrush="{DynamicResource DashAccentBlue}"
                                         SelectionOpacity="0.35"
                                         Cursor="IBeam"
                                         FocusVisualStyle="{x:Null}"
                                         SpellCheck.IsEnabled="False"
                                         Text="A perspicacious owl kept a sesquipedalian dictionary beside an ephemeral fountain, tucked inside a labyrinthine garden that smelled of petrichor after the rain." />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashDetailBlock}">
                        <TextBlock x:Name="HowToUseBody"
                                   Style="{StaticResource DashDetailBody}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Shortcuts info (always visible, bottom-right) -->
        <Button x:Name="ShortcutsInfoBtn"
                Grid.ColumnSpan="2"
                Style="{StaticResource DashInfoFab}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                Panel.ZIndex="30"
                Click="ShortcutsInfo_Click" />

        <Grid x:Name="ShortcutsOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="20"
              Visibility="Collapsed">
            <Border Background="{DynamicResource DashShortcutsOverlay}"
                    MouseDown="ShortcutsOverlayBackdrop_MouseDown" />
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,28,78"
                    Background="{DynamicResource DashShortcutsPanelBg}"
                    BorderBrush="{DynamicResource DashShortcutsPanelBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,18"
                    MinWidth="300"
                    MaxWidth="360"
                    MouseDown="ShortcutsPanel_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.35"
                                      BlurRadius="16"
                                      ShadowDepth="4"
                                      Direction="270" />
                </Border.Effect>
                        <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Shortcuts"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DashInk}"
                                   VerticalAlignment="Center" />
                        <Button Content="&#xE711;"
                                Style="{StaticResource DashCloseBtn}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ShortcutsOverlayClose_Click" />
                    </Grid>
                    <Border Style="{StaticResource DashShortcutRow}">
                        <StackPanel>
                            <TextBlock Text="Shift + select" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DashInk}" />
                            <TextBlock Text="Default mode. Toggle Instant in Settings to skip holding Shift."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashShortcutRow}">
                        <StackPanel>
                            <TextBlock Text="Ctrl + Enter" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DashInk}" />
                            <TextBlock Text="Ask “What does this mean?” from the pill."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashShortcutRow}">
                        <StackPanel>
                            <TextBlock Text="Escape" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DashInk}" />
                            <TextBlock Text="Answer card → pill. Pill → hide overlay."
                                       Style="{StaticResource DashRowDesc}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
