<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="IdkFontBody">pack://application:,,,/Assets/Fonts/#Inter, Segoe Fluent Emoji, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="IdkFontDisplay">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="IdkFontSymbol">Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="IdkFontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource IdkFontBody}" />
    </Style>

</ResourceDictionary>
