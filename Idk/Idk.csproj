<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Idk</RootNamespace>
    <!-- Shipped name: lowercase idk (Task Manager, exe on disk, assembly identity) -->
    <AssemblyName>idk</AssemblyName>
    <AssemblyTitle>idk</AssemblyTitle>
    <Product>idk</Product>
    <Company>idk</Company>
    <Version>0.1.12</Version>
    <AssemblyVersion>0.1.12.0</AssemblyVersion>
    <FileVersion>0.1.12.0</FileVersion>
    <InformationalVersion>0.1.12</InformationalVersion>
    <ApplicationIcon>Assets\idk.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Icon generator lives under this folder; do not compile it into the WPF app. -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="Services\EmbeddedOpenRouter.g.cs" />
    <None Include="tools\**\*.cs" />
  </ItemGroup>

  <Target Name="SealOpenRouter" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\seal-openrouter.ps1&quot;" />
    <ItemGroup>
      <Compile Include="Services\EmbeddedOpenRouter.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\idk.png" />
    <Resource Include="Assets\idk.ico" />
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
